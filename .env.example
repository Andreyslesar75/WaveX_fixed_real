# ФАЙЛ: .env.example
# Это шаблон настроек API.
#
# КАК ИСПОЛЬЗОВАТЬ:
# 1. Скопируй этот файл в новый файл с именем .env
# 2. Пока НЕ вставляй реальные Binance API ключи.
# 3. Сначала тестируй только в бумажном режиме.
#
# ВАЖНО:
# REAL_TRADING=false — это безопасный бумажный режим.
# REAL_TRADING=true  — это реальные деньги, только после проверок.

BINANCE_API_KEY=
BINANCE_API_SECRET=

# false = бумажная торговля, безопасно
# true  = реальная торговля, опасно
REAL_TRADING=false

# Стартовый баланс для бумажного режима
PAPER_BALANCE=1000